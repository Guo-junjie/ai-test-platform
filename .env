# ============ 数据库 ============
POSTGRES_USER=aitp
POSTGRES_PASSWORD=aitp_secret_2026
POSTGRES_DB=ai_test_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ RabbitMQ ============
RABBITMQ_USER=aitp
RABBITMQ_PASSWORD=aitp_secret_2026
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ============ MinIO ============
MINIO_ROOT_USER=aitp
MINIO_ROOT_PASSWORD=aitp_secret_2026
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aitp
MINIO_SECRET_KEY=aitp_secret_2026
MINIO_BUCKET=ai-test-platform
MINIO_SECURE=false

# ============ GitHub OAuth ============
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ============ SVN ============
SVN_DEFAULT_TIMEOUT=120

# ============ AI 模型配置（运行时也可通过 API 配置） ============
# 默认模型（OpenAI 兼容 API）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o

# 备用模型
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20241022

# 自定义模型（私有部署 / 国产模型）
CUSTOM_MODEL_API_BASE=
CUSTOM_MODEL_API_KEY=
CUSTOM_MODEL_NAME=

# ============ 安全 ============
SECRET_KEY=change-this-to-a-random-secret-key-in-production
AES_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key

# ============ 应用 ============
APP_ENV=development
APP_DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=3000
WORKSPACE_DIR=/app/data/repos
REPORT_DIR=/app/data/reports

# ============ 自动覆盖率采集（能力11） ============
# 1=流水线启动被测服务时自动注入覆盖率探针（Python: coverage run；Java: JaCoCo agent），
#   测试完成后自动采集入库（覆盖率页可见 source=AUTO 的报告）。
# 0=关闭（默认），仅支持手动上传覆盖率报告。
# 前提：celery-worker 容器已挂载 /var/run/docker.sock（见 docker-compose.yml）。
AUTO_COVERAGE=1
