%% ============ 能力3：AI 生成单接口用例 · 接纳闭环 ============
sequenceDiagram
    actor U as 用户
    participant FE as CaseLibrary.vue
    participant API as case_library API
    participant DB as PostgreSQL
    participant G as TestCaseGenerator
    participant R as ModelRouter(case_generation)

    U->>FE: 选项目/接口 → 点击「AI 生成」
    FE->>API: POST /api/cases/generate {project_id, endpoint_ids?}
    API->>DB: 查询 api_endpoints（project_id / ids）
    DB-->>API: 接口资产列表
    loop 每个接口（并发 ≤5, Semaphore）
        API->>API: 构造 api_info + 轻量 business_analysis
        API->>G: generate_api_cases(api_info, business_analysis)
        G->>R: call(use_case="case_generation")
        R-->>G: cases JSON
        G-->>API: 标准化 cases（AI 失败走 fallback）
    end
    API->>DB: 批量插入 test_case_assets(status=DRAFT, source=AI_GENERATED)
    DB-->>API: 已落库
    API-->>FE: {generated, inserted}
    U->>FE: 预览四类用例 → 逐条「采纳」
    FE->>API: POST /api/cases/{id}/adopt
    API->>DB: UPDATE status=ADOPTED
    API-->>FE: 成功(沉淀为资产)

%% ============ 能力4：AI 编排测试场景 ============
sequenceDiagram
    actor U as 用户
    participant FE as Scenario.vue
    participant API as scenario API
    participant RT as EndpointRetriever
    participant DB as PostgreSQL
    participant OR as ScenarioOrchestrator
    participant R as ModelRouter(scenario_orchestration)

    U->>FE: 输入自然语言 + 选项目 → 「AI 编排」
    FE->>API: POST /api/scenarios {project_id, nl_input, endpoint_ids?}
    API->>RT: search(project_id, nl_input)
    RT->>DB: api_endpoints 模糊匹配(method/path/summary)
    DB-->>RT: 候选接口(带 match_score)
    RT-->>API: 候选列表
    API->>OR: orchestrate(nl_input, candidates)
    OR->>R: call(use_case="scenario_orchestration", response_format_json=True)
    alt AI 成功
        R-->>OR: steps JSON（绑定 endpoint_id + extract/inject）
        OR-->>API: steps, engine=ai
    else AI 失败 / 无 Key
        OR-->>API: 规则兜底 steps（按匹配顺序串联）, engine=rule
    end
    API->>DB: 插入 scenarios(status=ORCHESTRATED, steps)
    DB-->>API: 场景已建
    API-->>FE: 场景 + 步骤预览
    U->>FE: 编辑步骤 / 「采纳」
    FE->>API: PUT /api/scenarios/{id} 或 POST /adopt
    API->>DB: 更新 steps / status=ADOPTED
    API-->>FE: 成功
