# 复制为仓库根目录 .env.production。不要提交真实凭证。
# 所有镜像必须显式指定已验收的版本，推荐 registry/name@sha256:...。
BACKEND_IMAGE=
FRONTEND_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
RABBITMQ_IMAGE=
MINIO_IMAGE=
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=
AES_ENCRYPTION_KEY=
POSTGRES_USER=aitp
POSTGRES_DB=ai_test_platform
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=aitp
RABBITMQ_PASSWORD=
MINIO_ACCESS_KEY=aitp
MINIO_SECRET_KEY=
MINIO_BUCKET=ai-test-platform
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=
# 外部 TLS 网关的地址；必须按实际域名填写。
CORS_ORIGINS=https://test.example.com
REPORT_PUBLIC_BASE_URL=https://test.example.com
# 默认仅宿主回环地址可访问，由已有 TLS 网关反向代理。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
GITHUB_WEBHOOK_SECRET=
